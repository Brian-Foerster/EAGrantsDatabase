# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# old backup
index-old.tsx
.env.local.bak

# local scratch + dev-only tooling (not part of the app)
/tmp_work/
/public/mobile-viewer.html

# data directories (source data, not built artifacts)
/data/source/
/data/processed/
/data/raw/*
# ...except manually-curated supplemental grant inputs (FLI, Meta Charity Funders,
# Navigation), which cannot be re-fetched from the web and must be versioned.
!/data/raw/supplemental/
# ...and the regrant source data (BlueDot, Manifund), which build-data merges in and
# which CI needs to rebuild public/data consistently.
!/data/raw/bluedot-regrants.json
!/data/raw/manifund-regrants.json

# NOTE: lib/scraped-grants.json IS tracked in git so GitHub Actions can build the site
# Run "npm run scrape" locally to update it, then commit the changes

# generated data (optionally versioned)
# /public/data/grants.min.json
# /public/data/grants.full.json
# /public/data/search-index.json
# /public/data/metadata.json
# /public/data/agg/*.json
# Keep .gitkeep files to ensure directories exist
!/public/data/.gitkeep
!/public/data/agg/.gitkeep

